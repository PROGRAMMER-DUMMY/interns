# ═════════════════════════════════════════════════════════════════════════════
#  autoresearch — runtime lock (TEMPLATE)
# ═════════════════════════════════════════════════════════════════════════════
#  Copy to config/lock.toml (gitignored) and set your values:
#      cp config/lock.toml.example config/lock.toml
#
#  Read by core/config.py. Secrets are NOT stored here — this file holds the
#  NAMES of the env vars that carry secret values (host_env/token_env/...).
#  Put the actual values in .env (gitignored). See config/README.md.
# ═════════════════════════════════════════════════════════════════════════════

[databricks]
enabled    = false            # true -> route execution/deployment to Databricks
execution  = "warehouse"      # warehouse (SQL) | jobs | duckdb | connect
fallback   = "duckdb"         # duckdb | fail  — used when remote is unavailable
catalog    = "autoresearch"   # target Unity Catalog (must already exist)
schema     = "experiments"    # target schema inside the catalog

# Env var NAMES that hold the secret/connection values (values live in .env):
host_env       = "DATABRICKS_HOST"
token_env      = "DATABRICKS_TOKEN"
http_path_env  = "DATABRICKS_HTTP_PATH"   # required for execution = "warehouse"

# Alternative to the above for local dev: if host_env/token_env resolve empty,
# the platform falls back to this ~/.databrickscfg profile (the same auth
# `databricks auth login` / `databricks configure` already manage) -- no need
# to duplicate a token into .env on a workstation already authenticated via
# the CLI. CI/Airflow-worker contexts without a ~/.databrickscfg should keep
# using host_env/token_env instead.
profile        = "DEFAULT"
http_path      = ""           # non-secret; can be set directly here instead of via http_path_env

trace_redact   = true         # redact secrets from traces
http_timeout_sec = 60
