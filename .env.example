# ─────────────────────────────────────────────────────────────────────────────
# autoresearch — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Databricks (required when [databricks] enabled = true in lock.toml) ──────
DATABRICKS_HOST=https://adb-<workspace-id>.<region>.azuredatabricks.net
DATABRICKS_TOKEN=dapi<your-personal-access-token>

# Required only for execution = "warehouse" mode
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# ── LLM API Keys (existing) ───────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── MCP servers only (NOT read by the app's .env loader) ──────────────────────
# These are consumed by Claude Code's MCP layer, which reads the process
# environment, not this file. Set them in .claude/settings.local.json "env" or
# as OS environment variables, then restart the CLI. Listed here for one
# canonical inventory of every variable the platform touches.
#   GITHUB_PERSONAL_ACCESS_TOKEN=ghp_<your-token>        # github MCP
#   DATABRICKS_HOST / DATABRICKS_TOKEN                   # databricks MCP (same as above)
