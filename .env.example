# ═════════════════════════════════════════════════════════════════════════════
#  autoresearch — environment template
# ═════════════════════════════════════════════════════════════════════════════
#  1. Copy this file:            cp .env.example .env       (PowerShell: copy)
#  2. Fill in the values below.  .env is gitignored — never commit it.
#  3. Load it for any CLI/app:   scripts/with-env.ps1 <claude|gemini|green-gate>
#                                scripts/with-env.sh  <...>        (bash/WSL)
#
#  with-env loads this file into the process environment, so a single .env feeds
#  BOTH the app (reads os.environ) AND every CLI's MCP layer (.mcp.json ${VAR}).
#
#  NOTE: this is a TEMPLATE — placeholders only. Put REAL secrets in .env, never here.
#
#  Legend:  [app] runtime   [mcp] MCP server   [secret] keep private   [opt] optional
# ═════════════════════════════════════════════════════════════════════════════


# ── Databricks ───────────────────────────────────────────────────────────────
#   [app] when lock.toml [databricks] enabled = true   ·   [mcp] databricks server
DATABRICKS_HOST=https://dbc-<workspace-id>.cloud.databricks.com
DATABRICKS_TOKEN=dapi<your-personal-access-token>          # [secret]
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>    # [opt] only for execution = "warehouse"


# ── LLM API keys ─────────────────────────────────────────────────────────────
#   [app] runtime model calls   ·   [secret]
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=


# ── GitHub ───────────────────────────────────────────────────────────────────
#   [mcp] github server (issues / PRs / Actions)   ·   [secret]
#   Classic PAT: scope `repo` (or `public_repo`); add `workflow` only to edit CI YAML.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_<your-token>
