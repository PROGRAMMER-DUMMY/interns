# --- Secrets / local config (NEVER commit) ---
.env
.env.*
!.env.example
config/lock.toml
!config/lock.toml.example
.claude/settings.local.json
*.databrickscfg
*.pem
*.key
*.p12
credentials*

# --- Per-run / generated output (not source) ---
workspaces/**/interns/
state/
.agents/sessions/
*.duckdb
*.db
*.sqlite
*.log

# --- MLflow local run artifacts (not source) ---
mlruns/
mlflow.db

# --- Caches / build / IDE ---
__pycache__/
*.py[cod]
.venv/
# Isolated docling env -- kept OUT of .venv so torch cannot resolve against
# pinned pyspark<4 / deltalake / numpy<2.0. See core/onboarding/documents/docling_loader.py
.venv_docling/
# Serena MCP server state (cache + its own memories); tool-local, not repo content.
.serena/
# Per-tool skill adapters are GENERATED, never hand-maintained. Canonical bodies
# live in skills/*/SKILL.md; regenerate with `uv run generate-skill-adapters`.
# Tracking near-duplicate copies per tool is exactly the drift that generator
# exists to prevent (AGENTS.md > Cross-Tool Skill Adapters).
.claude/skills/
.github/skills/
# Raw agent session transcripts dumped at the repo root. Large, and a raw log can
# carry pasted credentials -- never history.
*-local-command-caveat*.txt
.idea/
.ruff_cache/
.pytest_cache/
node_modules/
dist/
build/

# --- superpowers subagent-driven-development scratch (ledgers, briefs, review packages) ---
.superpowers/
.worktrees/

# --- Working/implementation plans: kept locally under docs/plans/, not committed ---
/PLAN_*.md
/docs/plans/*
# (already-committed shared plans stay tracked; gitignore only hides new/untracked ones)

# --- Internal dev/audit/enterprise-spec docs: not customer-facing, kept local by default ---
# core_audit/ includes security-gap and threat-model reports; enterprise/ is per-client spec
# material. Same rule as docs/plans/ above: only stops NEW/untracked files from being committed --
# it does not untrack or remove anything already committed.
/docs/core_audit/*
/docs/enterprise/*

# Databricks secrets
*.token

# Per-enterprise Databricks config (core.config.resolve_databricks_config) --
# same "real values for this machine, not committed" treatment as config/lock.toml.
config/enterprises/*/lock.toml
docker/airflow/.env
