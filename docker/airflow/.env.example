# Copy to `.env` (gitignored) before `docker compose up`.

# Airflow's own container UID. 50000 is the image default and the right value on
# Docker Desktop for Windows/macOS. On native Linux use `id -u` so files written
# into the mounted repo are owned by you, not root.
AIRFLOW_UID=50000

# Encrypts connections/variables at rest. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Which workspace the generated DAG binds to. Empty = no DAG is registered,
# which is why a fresh stack shows an empty DAG list.
AUTORESEARCH_PIPELINE_WORKSPACE=

# Airflow cron for the pipeline. Leave EMPTY for manual-trigger-only, which is
# the right default until the pipeline has run green end to end at least once.
# Event-driven scheduling comes from stage outlets (Assets), not from this.
AUTORESEARCH_PIPELINE_SCHEDULE=

DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=

# NOT AUTORESEARCH_ALLOW_REMOTE_EXECUTION. That is set by a human in the shell
# that runs the pipeline, never baked into a container.
