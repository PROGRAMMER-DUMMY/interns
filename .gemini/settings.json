      "run_shell_command(uv run finalize-kpi-generation)",
      "run_shell_command(uv run prepare-data-model-generation)",
      "run_shell_command(uv run apply-data-model-answer)",
      "run_shell_command(uv run finalize-data-model-generation)",
      "run_shell_command(uv run prepare-data-model-blocker-panel)",
      "run_shell_command(uv run apply-data-model-blocker-answer)",
      "run_shell_command(uv run prepare-duplicate-review-panel)",
      "run_shell_command(uv run apply-duplicate-review-answer)",
      "run_shell_command(uv run prepare-pipeline-format-panel)",
      "run_shell_command(uv run apply-pipeline-format-answer)",
      "run_shell_command(uv run apply-pipeline-decision)",
