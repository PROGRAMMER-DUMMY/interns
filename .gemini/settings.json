      "run_shell_command(uv run onboard-workspace)",
      "run_shell_command(uv run validate-workspace-artifacts)",
      "run_shell_command(uv run validate-project-harness)",
      "run_shell_command(uv run validate-workflow-guardrails)",
      "run_shell_command(uv run kpi-proof-packet)",
      "run_shell_command(uv run list-workspace-files)",
      "run_shell_command(uv run workspace-flow)",
      "run_shell_command(uv run prepare-workspace-workflow)",
