{
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md",
      "TOOLS.md",
      ".agents/tools.json",
      ".gemini/workspace-workflow-prompt.md",
      "docs/agents/gemini-cli-reference.md"
    ],
    "includeDirectoryTree": true
  },
  "model": {
    "summarizeToolOutput": {
      "run_shell_command": {
        "tokenBudget": 12000
      }
    }
  },
  "tools": {
    "truncateToolOutputThreshold": 120000,
    "_policyEngineNote": "`tools.allowed` is deprecated. Forward-looking equivalent rules live in .gemini/policies/autoresearch.toml; workspace-tier policies are non-functional today (gemini-cli#18186), so this allowlist still drives behavior. Symlink the .toml file into ~/.gemini/policies/ to silence the deprecation warning until the workspace tier ships.",
    "allowed": [
      "run_shell_command(uv run prepare-kpi-blocker-panel)",
      "run_shell_command(uv run apply-kpi-panel-answer)",
      "run_shell_command(uv run confirm-cli-agent-proposal)",
      "run_shell_command(uv run prepare-kpi-generation)",
